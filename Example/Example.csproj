<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net452;net462;net472;net481;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>	

		<!-- AssemblyInfo in Properties folder -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>	
		
		<!-- set restore source if needed. 
			Default to https://api.nuget.org/v3/index.json 
			https://apiint.nugettest.org/v3/index.json; for nuget sandbox 
		-->
		<RestoreSources>
			https://api.nuget.org/v3/index.json;
			https://apiint.nugettest.org/v3/index.json;
		</RestoreSources>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ScientiaMobile.Wurfl.Microservice.Client.t5" Version="2.1.5"/>
	</ItemGroup>

</Project>
